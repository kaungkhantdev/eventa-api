# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# comma-separated allowed origins, or * to allow any (dev only)
CORS_ORIGINS=http://localhost:5180

# ── Datastores (match docker-compose.yml) ────────────
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eventa:eventa@localhost:5672

# ── Observability ────────────────────────────────────
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=debug

# ── OpenAPI ──────────────────────────────────────────
# write openapi.json on boot (non-production) — consumed by eventa-web
EMIT_OPENAPI=true
