# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# comma-separated allowed origins, or * to allow any (dev only)
CORS_ORIGINS=http://localhost:5180
# public web app base URL — used to build shareable/public event links
PUBLIC_WEB_URL=http://localhost:5173
# checkout seat/GA hold lifetime, seconds (10m) — inventory releases after this
HOLD_TTL_SECONDS=600

# Payments (US-DISC-05). PCI SAQ-A: card data never reaches this service — the
# buyer pays on Stripe's own hosted page and comes back.
#
# BOTH keys are required: Stripe is the only payment provider, and there is no
# in-process stand-in to fall back on, so the app refuses to boot without them
# rather than discovering they are missing at the till. Test-mode values from
# the Stripe dashboard (Developers → API keys); a live sk_live_/rk_live_ key is
# REFUSED at boot unless NODE_ENV=production, so a test run cannot charge a
# real card.
#
# This is the PLATFORM's key — one pair for the whole deployment, not one per
# workspace. Each workspace connects its own Stripe account (`acct_…`, held in
# `payment_settings`) and this key charges ON BEHALF OF it, which is what keeps
# a tenant's own Stripe secret out of this product entirely. Nothing here is
# ever per-tenant; if you find yourself wanting a second pair, read the
# MerchantAccountPort docstring first.
#
# Because charges are made on the connected account, Stripe fires their events
# on THAT account — a plain endpoint sees nothing and orders never settle. The
# endpoint must listen to connected accounts:
#   stripe listen --forward-connect-to localhost:3000/api/v1/public/payments/webhook
# and in the dashboard, the endpoint must have "Listen to events on Connected
# accounts" ticked. The secret below is the one that command prints.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PROMPTPAY_EXPIRY_SECONDS=900

# Object storage for profile photos (US-DISC-11). The browser PUTs straight to
# the bucket with a presigned URL — the bytes never pass through this API.
# `memory` keeps everything in-process, so local dev needs no AWS account.
STORAGE_PROVIDER=memory
UPLOAD_MAX_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=300
# For a real bucket:
#   STORAGE_PROVIDER=s3
#   S3_BUCKET=eventa-uploads
#   S3_REGION=ap-southeast-1
#   S3_PUBLIC_BASE_URL=https://cdn.eventa.co.th   # CDN in front of the bucket
# In deployment omit the two keys below so the pod's IAM role is used instead.
# Set them (with S3_ENDPOINT) only to point at MinIO locally:
#   S3_ENDPOINT=http://localhost:9000
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin

# ── Datastores (match docker-compose.yml) ────────────
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eventa:eventa@localhost:5672

# ── Auth (JWT) ───────────────────────────────────────
# Use a long random string in real environments (never commit the real value).
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900     # access token lifetime, seconds (15m)
JWT_REFRESH_TTL=604800 # refresh token lifetime, seconds (7d)
# sign-in brute-force protection (US-ACC-12): lock after N fails for a cool-off
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900  # 15m

# ── Observability ────────────────────────────────────
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=debug

# ── OpenAPI ──────────────────────────────────────────
# write openapi.json on boot (non-production) — consumed by eventa-web
EMIT_OPENAPI=true
