# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# comma-separated allowed origins, or * to allow any (dev only)
CORS_ORIGINS=http://localhost:5180
# public web app base URL — used to build shareable/public event links
PUBLIC_WEB_URL=http://localhost:5173
# where THIS service is reachable FROM STRIPE. Shown to organizers so they can
# register their workspace's webhook endpoint, so localhost only works with a
# tunnel (`stripe listen`, ngrok). In deployment, the real public host.
PUBLIC_API_URL=http://localhost:3000
# checkout seat/GA hold lifetime, seconds (10m) — inventory releases after this
HOLD_TTL_SECONDS=600

# Payments (US-DISC-05). PCI SAQ-A: card data never reaches this service — the
# buyer pays on Stripe's own hosted page and comes back.
#
# There is deliberately NO Stripe key here, and its absence is the safety
# property. Credentials are per WORKSPACE: each organizer pastes their own
# publishable and secret key on Settings -> Payments, and the API stores them
# encrypted under SECRET_ENCRYPTION_KEY. A platform key would be a fallback
# that quietly took one workspace's money into somebody else's account.
#
# Live keys are refused unless NODE_ENV=production, so a local run or a seed
# script cannot charge a real card. That check moved here from boot-time env
# validation when the credential did.
#
# Webhooks are per workspace too: each gets its own URL, ending in a token the
# API mints on first save, and the signing secret Stripe issues for THAT
# endpoint is pasted alongside the keys. One shared endpoint could not work —
# a signature cannot be verified until you know whose secret to check it with.
# In dev:
#   stripe listen --forward-to localhost:3000/api/v1/public/payments/webhook/<token>
PROMPTPAY_EXPIRY_SECONDS=900
# ── Object storage: uploads ──────────────────────────
# Cover images, workspace logos, profile photos. The browser PUTs straight to
# the bucket with a presigned URL, so the bytes never pass through this API.
#
# There is one backend, an S3 bucket, and S3_BUCKET/S3_REGION are required —
# the app refuses to boot without them. Locally the bucket is MinIO, which
# speaks the same API; S3_ENDPOINT is what points at it. Same adapter, same
# code path in dev and in production, different address.

# LOCAL — MinIO, which `docker compose up -d` brings up with the bucket ready.
S3_BUCKET=eventa-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
UPLOAD_MAX_BYTES=5242880
UPLOAD_URL_TTL_SECONDS=300

# REAL S3 — replace the block above with this one.
#
#   S3_BUCKET=eventa-uploads-prod
#   S3_REGION=ap-southeast-1
#   S3_PUBLIC_BASE_URL=https://cdn.eventa.co.th
#   UPLOAD_MAX_BYTES=5242880
#   UPLOAD_URL_TTL_SECONDS=300
#
# NO S3_ENDPOINT. It exists to point at MinIO, and setting it also switches the
# client to path-style addressing, which S3 rejects for new buckets — the
# symptom is SignatureDoesNotMatch.
#
# NO KEYS in production. With both absent the SDK falls back to the instance's
# IAM role, which is the only credential that should exist there. Set them ONLY
# when running outside AWS — these two are Amazon's own published examples and
# are not valid credentials:
#
#   S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Three things live on the BUCKET, not in here. MinIO does all three by
# default, S3 does none of them, and each fails in a way that reads as a bug in
# the app:
#
# 1. CORS, or the browser's PUT is blocked before it is sent — a CORS message
#    in the console and no S3 error anywhere. AllowedHeaders must cover exactly
#    the headers the presigned URL signs:
#
#      [{ "AllowedOrigins": ["https://app.eventa.co.th"],
#         "AllowedMethods": ["PUT"],
#         "AllowedHeaders": ["content-type", "content-length"],
#         "MaxAgeSeconds": 3000 }]
#
# 2. Public reads, or the upload succeeds and the <img> 403s. Keep Block Public
#    Access ON and put CloudFront in front with an Origin Access Control, then
#    point S3_PUBLIC_BASE_URL at the distribution. Opening the bucket instead
#    works and is worse: every key becomes readable by anyone who guesses one,
#    and the CDN the stored URLs assume is bypassed.
#
# 3. IAM, on `arn:aws:s3:::eventa-uploads-prod/*`:
#
#      s3:PutObject     the presigned upload, and the copy's destination
#      s3:GetObject     read back to verify the magic bytes, and the copy source
#      s3:DeleteObject  drop the staged object once it is promoted
#
#    HeadObject is covered by s3:GetObject. No s3:ListBucket — nothing here
#    enumerates, so a leaked credential cannot inventory what other workspaces
#    have uploaded.
#
# Getting S3_REGION wrong answers 301 PermanentRedirect, which says nothing.

# ── Datastores (match docker-compose.yml) ────────────
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eventa:eventa@localhost:5672

# ── Auth (JWT) ───────────────────────────────────────
# Use a long random string in real environments (never commit the real value).
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900     # access token lifetime, seconds (15m)
JWT_REFRESH_TTL=604800 # refresh token lifetime, seconds (7d)
# sign-in brute-force protection (US-ACC-12): lock after N fails for a cool-off
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900  # 15m

# ── Observability ────────────────────────────────────
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=debug

# ── OpenAPI ──────────────────────────────────────────
# write openapi.json on boot (non-production) — consumed by eventa-web
EMIT_OPENAPI=true
