# Copy to .env and adjust. .env is git-ignored — never commit secrets.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# comma-separated allowed origins, or * to allow any (dev only)
CORS_ORIGINS=http://localhost:5180
# public web app base URL — used to build shareable/public event links
PUBLIC_WEB_URL=http://localhost:5173
# checkout seat/GA hold lifetime, seconds (10m) — inventory releases after this
HOLD_TTL_SECONDS=600

# Payments (US-DISC-05). PCI SAQ-A: card data never reaches this service.
# `fake` is the in-process double for local dev and tests; `stripe` refuses to
# boot unless both secrets below are set.
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PROMPTPAY_EXPIRY_SECONDS=900

# ── Datastores (match docker-compose.yml) ────────────
DATABASE_URL=postgres://eventa:eventa@localhost:5432/eventa
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://eventa:eventa@localhost:5672

# ── Auth (JWT) ───────────────────────────────────────
# Use a long random string in real environments (never commit the real value).
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_ACCESS_TTL=900     # access token lifetime, seconds (15m)
JWT_REFRESH_TTL=604800 # refresh token lifetime, seconds (7d)
# sign-in brute-force protection (US-ACC-12): lock after N fails for a cool-off
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900  # 15m

# ── Observability ────────────────────────────────────
# pino level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=debug

# ── OpenAPI ──────────────────────────────────────────
# write openapi.json on boot (non-production) — consumed by eventa-web
EMIT_OPENAPI=true
